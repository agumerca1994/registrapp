# Secretos — nunca en git
.env
# Webhook de deploy de Easypanel. Archivo aparte y no .env porque
# docker-compose inyecta .env entero en los contenedores, y el token no tiene
# por qué estar en el environment de la app.
.deploy.env
backend/firebase-credentials.json
**/firebase-credentials.json
**/*.json.secret

# Archivos de contexto locales (PDFs de resúmenes, datos personales, etc.)
/context/
# Un patrón, no una carpeta por banco: cada importador nuevo crea su propio
# _staging_<banco>/ con resúmenes reales adentro, y listarlas de a una hizo que
# tres quedaran expuestas en un repo público hasta que alguien las mirara.
backend/scripts/_staging*/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-import/
*.egg-info/

# Node
node_modules/
.next/
*.local
*.tsbuildinfo
next-env.d.ts

# Playwright — ephemeral run output, NOT the committed snapshot baselines
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Docker
.docker/

# OS
.DS_Store
Thumbs.db
firebase-debug.log

# Duplicado del registro global en ~/.claude.json, y ahí es donde vive la clave.
.mcp.json
