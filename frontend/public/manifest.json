{
  "id": "/",
  "name": "RegistrApp",
  "short_name": "RegistrApp",
  "description": "Finanzas personales inteligentes",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F7F7FB",
  "theme_color": "#5B4FE9",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icon",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-icon",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Registrar gasto",
      "short_name": "Registrar",
      "description": "Cargar un gasto en un paso",
      "url": "/registrar?source=quick",
      "icons": [
        {
          "src": "/icon",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/registrar/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "application/pdf",
            ".pdf",
            "image/jpeg",
            ".jpg",
            ".jpeg",
            "image/png",
            ".png",
            "image/webp",
            ".webp"
          ]
        }
      ]
    }
  }
}
