# ─── Base de datos ───────────────────────────────────────────────
POSTGRES_DB=registrapp
POSTGRES_USER=registrapp
POSTGRES_PASSWORD=cambia_esta_password

# ─── Firebase Admin SDK (backend) ────────────────────────────────
# Descargá el JSON de credenciales desde Firebase Console →
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# ─── Firebase Client SDK (frontend) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── APIs de variables macro ──────────────────────────────────────
# Token de estadisticasbcra.com (para UVA, inflación, dólar)
ESTADISTICAS_BCRA_TOKEN=

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development

# ─── Playwright E2E (Firebase Auth Emulator) ──────────────────────
# Only set these when running the E2E suite locally, never in a real
# deploy. Start the emulator first: `npm run emulator` (from /frontend).
# The backend runs inside Docker, so it must reach the emulator (running on
# the host) via host.docker.internal, not 127.0.0.1/localhost.
# FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
