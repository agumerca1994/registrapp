# ─── Base de datos ───────────────────────────────────────────────
POSTGRES_DB=registrapp
POSTGRES_USER=registrapp
POSTGRES_PASSWORD=cambia_esta_password

# ─── Firebase Admin SDK (backend) ────────────────────────────────
# Descargá el JSON de credenciales desde Firebase Console →
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# ─── Firebase Client SDK (frontend) ──────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── APIs de variables macro ──────────────────────────────────────
# Token de estadisticasbcra.com (para UVA, inflación, dólar)
ESTADISTICAS_BCRA_TOKEN=

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
ENVIRONMENT=development

# ─── Playwright E2E (Firebase Auth Emulator) ──────────────────────
# Only set these when running the E2E suite locally, never in a real
# deploy. Start the emulator first: `npm run emulator` (from /frontend).
# The backend runs inside Docker, so it must reach the emulator (running on
# the host) via host.docker.internal, not 127.0.0.1/localhost.
# FIREBASE_AUTH_EMULATOR_HOST=host.docker.internal:9099
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# ─── Conector MCP (IA) ────────────────────────────────────────────
# Dominio de la API. En producción es obligatorio: de él se derivan el issuer
# OAuth (https://$API_DOMAIN) y el recurso canónico (https://$API_DOMAIN/mcp),
# que es la dirección que el usuario pega en Claude.
API_DOMAIN=
MCP_ENABLED=true
# Registro dinámico de clientes (RFC 7591). Es lo que usa Claude para darse de
# alta solo; apagalo únicamente si aparece abuso.
MCP_DCR_ENABLED=true
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_DAYS=30
# Sólo para desarrollo: expone /mcp sin token. Se ignora si ENVIRONMENT=production.
# MCP_AUTH_DISABLED=false
# No hace falta tocar ALLOWED_ORIGINS: /mcp, /oauth/* y /.well-known/* tienen su
# propio CORS con comodín en main.py.

# ─── Notificaciones push (Firebase Cloud Messaging) ───────────────────
# La "clave de par de claves" de Configuración del proyecto → Cloud Messaging
# → Certificados push web. Es pública (viaja en el bundle del frontend); sin
# ella el frontend no pide token y la sección de Configuración muestra el
# botón pero no registra nada.
#
# El backend NO necesita variable nueva: manda con la misma credencial de
# firebase-admin que ya usa para verificar los tokens de Auth. Lo que sí hace
# falta es tener Cloud Messaging habilitado en el proyecto de Firebase.
#
# OJO: el proyecto del emulador (demo-registrapp) no puede mandar push. En dev
# local todo se registra igual, pero el envío falla y queda logueado.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
